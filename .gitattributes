contract SlopeControl {
    struct SlopePosition {
        uint256 pointA;
        uint256 pointB;
        uint256 pointC; // Third point establishes continuity
        uint256 slopeFactor;
    }

    mapping(string => SlopePosition) public assetSlopes;

    function defineSlope(string memory assetSymbol, uint256 pointA, uint256 pointB, uint256 pointC) public {
        assetSlopes[assetSymbol] = SlopePosition(pointA, pointB, pointC, calculateSlopeFactor(pointA, pointB, pointC));
    }

    function calculateSlopeFactor(uint256 pointA, uint256 pointB, uint256 pointC) public pure returns (uint256) {
        return (pointC - pointA) / (pointB - pointA); // Ensuring smooth continuous rise
    }
}
