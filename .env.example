# Solidarity Platform Environment Configuration
# Copy to .env and configure for your environment

# =============================================================================
# SOLIDARITY NUMEROLOGICAL SYSTEM SETTINGS
# =============================================================================
# Core Henry 7 Step 14 Shoe Waltz Framework
HENRY_7_STEP_BASE=7
HENRY_7_STEP_DOUBLE=14
HENRY_7_STEP_SQUARE=49
HENRY_7_STEP_CONTROL_RATIO=3.5

# Dimensional Containment Settings
PREFERRED_DIMENSION=9D
ARCHIVE_DIMENSION=12D

# Cubit Calculation Settings
TOTAL_CUBITS=697
RING_AGGREGATE_CUBITS=686
VERIFICATION_LANE_CUBITS=7
CORE_QUAD_TILE_CUBITS=4

# System Integration Settings
PROCESSOR_ENABLED=true
SOUL_EDXCHANG_ENABLED=true
STONENSYNC_ENABLED=true

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
NODE_ENV=development
PORT=3000
HOST=localhost
API_VERSION=v1

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL=postgresql://solidarity_user:solidarity_pass@localhost:5432/solidarity_db
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE=10000

# =============================================================================
# REDIS CONFIGURATION (for caching and sessions)
# =============================================================================
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=solidarity:
REDIS_PASSWORD=

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
JWT_SECRET=your-super-secure-jwt-secret-here-minimum-32-characters
JWT_EXPIRATION=24h
REFRESH_TOKEN_EXPIRATION=7d
ENCRYPTION_KEY=your-encryption-key-here-32-characters
SESSION_SECRET=your-session-secret-here

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# =============================================================================
# HARMONIC SCALING & FRACTAL BALANCING SYSTEM
# =============================================================================
# Core harmonic scaling parameters
HARMONIC_SCALING_PRECISION=16
FRACTAL_BALANCE_DEPTH=7
GOLDEN_RATIO_SCALING=true
HARMONIC_RESONANCE_FACTOR=1.618033988749

# Fractal balancing configuration
FRACTAL_RECURSION_LEVELS=14
SCALE_INVARIANCE_CHECK=true
SELF_SIMILARITY_THRESHOLD=0.618
FRACTAL_DIMENSION_TARGET=1.414

# Mathematical scaling system
SCALING_BASE_FREQUENCY=432
HARMONIC_SERIES_LENGTH=49
FIBONACCI_SCALING=true
LUCAS_SEQUENCE_INTEGRATION=true

# System integration
PYTHON_PATH=python3
HARMONIC_PROCESSING_TIMEOUT=30000
MATHEMATICAL_PRECISION=high

# =============================================================================
# FINANCIAL CONFIGURATION
# =============================================================================
FINANCIAL_ENABLED=true
FINANCIAL_TEST_MODE=true
BLOCKCHAIN_NETWORK=ethereum
PROVIDER_URL=https://mainnet.infura.io/v3/your-infura-key
CONTRACT_ADDRESS=0x...
PRIVATE_KEY=your-private-key-here
GAS_LIMIT=21000
GAS_PRICE=auto
CONFIRMATIONS=3

# Financial Processing Specific
TRANSACTION_LIMIT=10000
DAILY_LIMIT=100000
AUDIT_LOGGING=true
COMPLIANCE_MODE=strict

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=debug
LOG_FORMAT=combined
LOG_FILE=logs/solidarity.log
LOG_MAX_SIZE=10MB
LOG_MAX_FILES=5
LOG_COMPRESS=true

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================
CLUSTERING=false
WORKERS=4
CACHE_ENABLED=true
CACHE_TTL=300000
COMPRESSION_THRESHOLD=1024
MEMORY_LIMIT=512MB
METRICS_ENABLED=true

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
FRONTEND_ENABLED=true
FRONTEND_BUILD_PATH=./frontend/build
API_URL=http://localhost:3000/api
SOCKET_URL=http://localhost:3000
ASSETS_PATH=/static
INDEX_FILE=index.html

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================
HOT_RELOAD=true
MOCK_DATA=false
DEBUG_MODE=true
API_DOCS=true
DEV_MIDDLEWARE=true
SOURCE_MAP=true

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================
MONITORING_ENABLED=true
HEALTH_CHECK=true
PROMETHEUS_ENABLED=false
GRAFANA_ENABLED=false
ALERTS_ENABLED=true
ERROR_REPORTING=true

# =============================================================================
# THIRD-PARTY SERVICES
# =============================================================================
# Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Cloud Storage (AWS S3, Google Cloud, etc.)
CLOUD_STORAGE_PROVIDER=aws
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=solidarity-bucket

# Payment Processing
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Analytics
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX

# =============================================================================
# SSL/TLS CONFIGURATION (for production)
# =============================================================================
SSL_ENABLED=false
SSL_CERT_PATH=/path/to/cert.pem
SSL_KEY_PATH=/path/to/key.pem
SSL_CA_PATH=/path/to/ca.pem

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION=30
BACKUP_STORAGE=local
BACKUP_PATH=./backups

# =============================================================================
# FEATURE FLAGS
# =============================================================================
FEATURE_SPATIAL_AUDIO=true
FEATURE_FINANCIAL_TRADING=true
FEATURE_API_VERSIONING=true
FEATURE_REAL_TIME_UPDATES=true
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_MULTI_TENANT=false

# =============================================================================
# EXTERNAL API KEYS
# =============================================================================
OPENAI_API_KEY=your-openai-key
GOOGLE_MAPS_API_KEY=your-google-maps-key
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token

# =============================================================================
# SOLIDARITY PLATFORM CONFIGURATION
# =============================================================================
PLATFORM_NAME=Solidarity
PLATFORM_VERSION=2.41.0
SUPPORT_EMAIL=support@solidarity.com
CONTACT_PHONE=+1-555-0123
COMPANY_ADDRESS=Kansas, USA 66210

# =============================================================================
# QUICK REFERENCE
# =============================================================================
# For complete documentation, see: COMPLETE_SYSTEM_DOCUMENTATION.md
# Key commands:
#   node launcher.js corrected     # Start full system
#   node launcher.js discovery     # System discovery
#   npm test                       # Run test suite
#   node src/api/server.js         # Start API server
