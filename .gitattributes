# Auto detect text files and normalize line endings
* text=auto

# Ensure consistent LF endings for source files
*.js      text eol=lf
*.ts      text eol=lf
*.py      text eol=lf
*.sol     text eol=lf
*.md      text eol=lf
*.json    text eol=lf
*.yml     text eol=lf

# Treat images/binaries as binary (no diff / no normalization)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary

# Keep lock/config files stable
package-lock.json -text