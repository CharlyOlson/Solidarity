# Solidarity Platform Environment Configuration
# Copy this file to .env and fill in your actual values

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/solidarity_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=solidarity_db
DATABASE_USER=solidarity_user
DATABASE_PASSWORD=your_secure_password

# Blockchain Configuration
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/your_infura_key
GOERLI_RPC_URL=https://goerli.infura.io/v3/your_infura_key
ETHEREUM_PRIVATE_KEY=your_private_key_here
SOLIDARITY_CONTRACT_ADDRESS=0x...

# Treasury Wallet Addresses
COMMUNITY_POOL_ADDRESS=0x...
PAYROLL_TREASURY_ADDRESS=0x...
OPERATIONAL_RESERVE_ADDRESS=0x...
MAIN_TREASURY_ADDRESS=0x...

# API Keys
INFURA_PROJECT_ID=your_infura_project_id
ALCHEMY_API_KEY=your_alchemy_api_key

# Security
JWT_SECRET=your_jwt_secret_here
ENCRYPTION_KEY=your_encryption_key_here

# Application Settings
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# Treasury Management
COMMUNITY_POOL_PERCENTAGE=5
PAYROLL_TREASURY_PERCENTAGE=10

# External Services
EMAIL_SERVICE_API_KEY=your_email_service_key
NOTIFICATION_SERVICE_URL=https://api.notification-service.com

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/solidarity.log
