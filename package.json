{
  "name": "solidarity-platform",
  "version": "2.41.0",
  "description": "Full scale system for commerce - Solidity Platform by Scott Charles Olson",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "build": "npm run compile-contracts",
    "compile-contracts": "hardhat compile",
    "deploy-contracts": "hardhat run scripts/deploy.js",
    "migrate-db": "node scripts/migrate.js",
    "seed-db": "node scripts/seed.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "keywords": [
    "blockchain",
    "defi",
    "solidarity",
    "treasury-management",
    "governance",
    "stability-metrics"
  ],
  "author": "Scott Charles Olson (Charly)",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "dotenv": "^16.3.1",
    "pg": "^8.11.3",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "ethers": "^6.7.1",
    "web3": "^4.1.1",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "winston": "^3.10.0",
    "redis": "^4.6.7",
    "socket.io": "^4.7.2",
    "multer": "^1.4.5-lts.1",
    "compression": "^1.7.4",
    "swagger-ui-express": "^5.0.0",
    "swagger-jsdoc": "^6.2.8"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.6.2",
    "supertest": "^6.3.3",
    "eslint": "^8.46.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.0.1",
    "@hardhat/hardhat-toolbox": "^3.0.2",
    "hardhat": "^2.17.1",
    "@openzeppelin/contracts": "^4.9.3",
    "@openzeppelin/hardhat-upgrades": "^1.28.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=7.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/solidarity-io/solidarity.git"
  },
  "bugs": {
    "url": "https://github.com/solidarity-io/solidarity/issues"
  },
  "homepage": "https://github.com/solidarity-io/solidarity#readme"
}
